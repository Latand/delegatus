index e1f14ea..8501571 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -661,3 +661,11 @@ body {
       0 0 18px 4px color-mix(in srgb, var(--color-accent) 42%, transparent) !important;
   }
 }
+
+/* Press and open/close motion (#2148 round 2) is off under reduced motion:
+   the press still lands, the button just does not move. */
+@media (prefers-reduced-motion: reduce) {
+  .kb .btn, .kb .card .add, .pblock .pb-act, .kb .gsheet, .kb .gsheet-scrim,
+  .kb .card .history::details-content, .kb .draft-added::details-content { transition: none; }
+  .kb .btn:active, .kb .card .add:active, .pblock .pb-act:active { scale: none; }
+}
