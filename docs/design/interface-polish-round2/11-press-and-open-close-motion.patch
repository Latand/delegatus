 }
 .kb .btn:hover { border-color: var(--border-strong); }
+/* A discrete button answers a press (make-interfaces-feel-better #12): 0.96
+   for as long as it is held, springing back from wherever it got to. Cards,
+   rows, tabs and chips stay still: they are hit many times a minute (#19). */
+.kb .btn:active:not(:disabled), .kb .card .add:active { scale: 0.96; }
+.kb .card .add { transition: background var(--motion-fast), scale var(--motion-fast) ease-out; }
 .kb .btn svg { width: 15px; height: 15px; }
 .kb .btn .count { color: var(--color-muted); font-weight: 400; }
 .kb .btn.hidden-pill[data-count="0"] { display: none; }
@@ -955,11 +960,23 @@
 .kb .dir-TB .pport.in { top: -5px; left: calc(50% - 4.5px); }
 .kb .dir-TB .pport.out { bottom: -5px; left: calc(50% - 4.5px); }
 .kb .dir-TB .pport.out.fail { bottom: auto; left: auto; right: -5px; top: calc(66% - 4.5px); border-color: color-mix(in srgb, var(--color-danger) 60%, var(--border-strong)); }
-.kb .card .history { display: flex; flex-direction: column; gap: 4px; }
+.kb .card .history { display: block; }
 .kb .card .history summary { list-style: none; display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-label); color: var(--color-muted); cursor: pointer; border-radius: 4px; padding: 2px 4px; margin-left: -4px; min-height: 22px; }
 .kb .card .history summary::-webkit-details-marker { display: none; }
 .kb .card .history summary:hover { background: var(--surface-well); color: var(--color-secondary); }
 .kb .card .history summary .chev { width: 12px; height: 12px; transition: transform var(--motion-fast); }
+/* Past attempts opens and closes by height, interruptibly (#4): the content
+   box animates between 0 and its own height, and a second click mid-way
+   reverses from where it is. Chrome animates the content box of a block
+   <details> only, so the column and its 4 px gap move into that box. */
+.kb .card .history, .kb .draft-added { interpolate-size: allow-keywords; }
+.kb .card .history::details-content { display: flex; flex-direction: column; gap: 4px; }
+.kb .card .history > summary + * { margin-top: 4px; }
+.kb .card .history::details-content, .kb .draft-added::details-content {
+  height: 0; overflow: clip;
+  transition: height var(--motion-base) var(--ease-standard), content-visibility var(--motion-base) allow-discrete;
+}
+.kb .card .history[open]::details-content, .kb .draft-added[open]::details-content { height: auto; }
 .kb .card .history[open] summary .chev { transform: rotate(90deg); }
 .kb .card .history summary .hl { white-space: nowrap; font-weight: 700; color: var(--color-secondary); }
 .kb .card .history summary .lbl { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
@@ -995,6 +1012,12 @@
 
 /* The sheet: over the board and under its menus, receipts and the full-window reader. */
 .kb .gsheet-scrim { position: fixed; inset: 0; z-index: 62; background: rgb(10 10 16 / 0.32); display: flex; align-items: stretch; justify-content: center; padding: 12px; }
+/* The sheet rises 8 px and fades in; the scrim fades. It unmounts on close,
+   so the exit is the instant one. */
+.kb .gsheet-scrim { transition: opacity var(--motion-base) var(--ease-standard); }
+@starting-style { .kb .gsheet-scrim { opacity: 0; } }
+.kb .gsheet { transition: translate var(--motion-slow) var(--ease-standard), opacity var(--motion-base) var(--ease-standard); }
+@starting-style { .kb .gsheet { translate: 0 8px; opacity: 0; } }
 .kb .gsheet { width: min(1480px, 100%); display: flex; flex-direction: column; min-height: 0; border-radius: var(--radius-surface); background: var(--surface-raised); border: 1px solid var(--border-default); box-shadow: var(--shadow-2); overflow: hidden; }
 .kb .gsheet header { display: flex; align-items: center; gap: 10px; padding: 8px 10px 8px 16px; border-bottom: 1px solid var(--border-default); min-height: 52px; }
 .kb .gsheet header .kind { height: 20px; padding: 0 7px; display: inline-flex; align-items: center; border-radius: 999px; font-size: var(--text-caption); font-weight: 700; color: var(--color-muted); border: 1px solid var(--border-default); flex-shrink: 0; }
