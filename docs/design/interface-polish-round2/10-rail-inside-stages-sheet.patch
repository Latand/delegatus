+:root[data-role-frame="ribbon"] .kb .gsheet .reader.conv[data-role-host] {
+  border: 1px solid var(--border-default); border-left: 4px solid var(--role);
+  background: var(--surface-card); padding: 8px 12px 10px 9px;
