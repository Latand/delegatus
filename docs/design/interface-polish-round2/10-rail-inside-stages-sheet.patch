+  height: auto; margin-left: 0; padding: 0; gap: 7px; color: var(--role-ink); letter-spacing: 0.06em;
+  background: none; clip-path: none;
+}
+:root[data-role-frame="ribbon"] .kb .gsheet .reader .role-mark-emblem {
+  width: 22px; height: 22px; border-radius: 6px; color: #fff; background: var(--role-fill);
+  box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 18%, transparent);
+}
