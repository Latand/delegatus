  "benchmark": {
    "source": "const { initializeStateCollections, SqliteStateCollection } = await import(process.cwd()+\"/src/lib/state/sqliteStateStore.ts\");\nconst { buildPipeline, isStoredPipeline } = await import(process.cwd()+\"/src/lib/pipelines/store.ts\");\nconst { readHistoryProjection, historyAttemptCounts } = await import(process.cwd()+\"/src/lib/state/historyProjection.ts\");\nimport { Database } from \"bun:sqlite\";\nimport path from \"node:path\";\nconst now=\"2026-10-21T12:00:00.000Z\";\nconst role={roleId:\"builder\",engine:\"codex\",model:null,effort:null,access:\"read-write\",promptScaffold:\"fixture\"};\nconst rows=Array.from({length:48},(_,i)=>{\n const p=buildPipeline({id:`pipeline_${String(i).padStart(3,\"0\")}`,project:\"fixture\",task:\"fixture\",repoDir:\"/repo\",srcPath:null,srcConversationId:null,now,stages:[{id:\"build\",kind:\"run\",prompt:\"x\".repeat(4096),role:{roleId:\"builder\"},effectiveRole:role,next:null}] } as never);\n p.state=\"running\";p.runs[0]!.attempts=Array.from({length:12},(_,n)=>({n:n+1,state:n===11?\"running\":\"passed\",effectiveRole:role,launchId:null,sessionId:null,flowId:null,input:null,activatedBy:null,output:null,conversationId:`conversation_${i}_${n}`,agentPath:`fixture-${i}-${n}.jsonl`,paneId:null,startedAt:now,completedAt:n===11?null:now,verdict:n===11?null:{status:\"pass\"},error:\"x\".repeat(4096)})) as never;\n return p;\n});\nif(!rows.every(isStoredPipeline)) throw new Error(\"invalid benchmark pipeline\");\nconst spec={collection:\"pipelines\",schemaVersion:1,busyMessage:\"busy\",key:(p:typeof rows[number])=>p.id,decode:(r:unknown)=>r as typeof rows[number],clone:structuredClone};\nconst filename=path.join(process.env.LLV_STATE_DIR!,\"bench.sqlite\");\ninitializeStateCollections(filename,[{...spec,migrationId:\"bench\",loadRecords:()=>rows}]);const store=new SqliteStateCollection(filename,spec);\nconst samples=[];\nfor(let cycle=0;cycle<8;cycle++){\n const start=performance.now();\n for(const row of rows){row.runs[0]!.attempts[11]!.state=cycle%2?\"running\":\"pending\";store.boundedPatch(1,tx=>tx.put(row));}\n const written=performance.now();\n const count=await readHistoryProjection(db=>historyAttemptCounts(db,\"fixture\",Date.parse(now)),{filename});\n if(!count || count.builder!==576)throw new Error(JSON.stringify(count));\n const end=performance.now();if(cycle)samples.push({write:written-start,history:end-written,total:end-start});\n}\nconsole.log(JSON.stringify({sqlite:new Database(\":memory:\").query(\"SELECT sqlite_version() AS version\").get(),rows:48,attempts:12,payloadBytes:JSON.stringify(rows[0]).length,samples}));\n",
    "command": "bash scripts/gate-slot.sh bun \"$TMPDIR/bench.ts\"",
    "environment": "Fresh isolated HOME, XDG_CONFIG_HOME, TMPDIR, LLV_STATE_DIR and LLV_VIEWER_CONTROL_URL=http://127.0.0.1:1 for each process; benchmark source saved outside each export."
