#!/usr/bin/env bash
set -euo pipefail
[ "${LLV_SKIP_HOOKS:-0}" = "1" ] && exit 0
# Git exports these while invoking a hook. Child git commands in the gate must
# resolve their own fixture repositories, including from linked worktrees.
for name in GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_OBJECT_DIRECTORY GIT_DIR GIT_WORK_TREE GIT_IMPLICIT_WORK_TREE GIT_GRAFT_FILE GIT_INDEX_FILE GIT_NO_REPLACE_OBJECTS GIT_REPLACE_REF_BASE GIT_PREFIX GIT_SHALLOW_FILE GIT_COMMON_DIR; do
  unset "$name"
done
for name in ${!GIT_CONFIG_KEY_@} ${!GIT_CONFIG_VALUE_@}; do unset "$name"; done
exec bun scripts/local-gate.ts pre-push
