{
  "name": "delegatus-landing",
  "main": "entry.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/stats", "/stats/", "/stats/*"]
  },
  "vars": {
    "STATS_ORIGIN": "https://delegatus.org",
    "STATS_RP_ID": "delegatus.org"
  },
  "durable_objects": {
    "bindings": [{ "name": "STATS", "class_name": "StatsStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatsStore"] }],
  "version_metadata": { "binding": "STATS_VERSION" },
  "routes": [
    { "pattern": "delegatus.org", "custom_domain": true },
    { "pattern": "www.delegatus.org", "custom_domain": true }
  ],
  "workers_dev": false
}
